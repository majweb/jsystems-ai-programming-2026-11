.DS_Store
# Installed agent skills are not committed: skills-lock.json (committed) is the source
# of truth for which skills are used and at which commit, so reinstall from it.
# Skills written in this repository are not in the lock file and are kept as exceptions.
# .claude/skills/ holds the CLI's links to .agents/skills/.
.agents/skills/*
!.agents/skills/verified-research
.claude/skills/*
!.claude/skills/verified-research
__pycache__/
*.pyc
.playwright-cli
playwright-report/
test-results/
playwright/.cache/

# Local Codex history, credentials and runtime state; keep shared config and rules.
.codex/auth.json
.codex/sessions/
.codex/archived_sessions/
.codex/history.jsonl
.codex/session_index.jsonl
.codex/log/
.codex/logs/
.codex/tmp/
.codex/*.sqlite*

# Private agent briefs and Java build artifacts
.agent-briefs/
**/target/
*.class
/.idea
